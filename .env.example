# ─── Production / local environment template ─────────────────────────────────
# Copy to `.env` (local) or `.env.production` (CI / host build).
# `.env*` is gitignored except this example file.
#
# IMPORTANT:
# - Every VITE_* value is PUBLIC — it is embedded in the browser JS bundle.
# - Never put private secrets (Resend API keys, database passwords) in VITE_*.
# - Put private secrets only in Cloudflare Worker / server environment variables.

# ── Contact delivery (pick ONE) ──────────────────────────────────────────────
# All submissions should be delivered to: info@mernify.co
#
# Option A — Cloudflare Worker (cf-worker/contact.js) + Resend
# VITE_CONTACT_ENDPOINT=https://mernify-contact.YOUR_SUBDOMAIN.workers.dev
# Worker secrets/vars (NOT VITE_*): RESEND_API_KEY, CONTACT_TO=info@mernify.co,
# CONTACT_FROM=Mernify <info@mernify.co> (domain must be verified in Resend)

# Option B — Web3Forms (https://web3forms.com) — access key is public by design
# Configure the Web3Forms dashboard inbox to info@mernify.co
# VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# ── Booking ──────────────────────────────────────────────────────────────────
# VITE_CALENDLY_URL=https://calendly.com/YOUR_ORG/discovery

# ── Analytics (loads only after cookie consent) ──────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Optional: case study live-site preview proxy ─────────────────────────────
# VITE_PROXY_URL=https://mernify-preview.YOUR_SUBDOMAIN.workers.dev

# ── Mernify AI Sales Concierge ───────────────────────────────────────────────
# Deploy cf-worker/ai-chat.js to Cloudflare Workers, then paste its URL here.
# Without this, the chat runs in dev-fallback mode locally and is disabled in prod.
# VITE_AI_CHAT_ENDPOINT=https://mernify-ai.YOUR_SUBDOMAIN.workers.dev

# Feature flag: "true" = always on, "false" = always off, unset = on in dev / auto in prod
# VITE_MERNIFY_AI_ENABLED=true

# Worker secrets (set in Cloudflare Dashboard → Workers → Settings — NOT here):
#   AI_PROVIDER          = anthropic          (or openai)
#   AI_API_KEY           = sk-ant-...         [Secret]
#   AI_PRIMARY_MODEL     = claude-haiku-4-5-20251001
#   AI_FALLBACK_MODEL    = claude-haiku-4-5-20251001
#   RESEND_API_KEY       = re_...             [Secret] — for lead email delivery
#   CONTACT_TO           = info@mernify.co
#   CONTACT_FROM         = Mernify <info@mernify.co>
#   ALLOWED_ORIGIN       = https://mernify.co,https://www.mernify.co
