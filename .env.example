# ─── Production / local environment template ─────────────────────────────────
# Copy to `.env` (local) or `.env.production` (CI / host build).
# `.env*` is gitignored except this example file.
#
# IMPORTANT:
# - Every VITE_* value is PUBLIC — it is embedded in the browser JS bundle.
# - Never put private secrets (Resend API keys, database passwords) in VITE_*.
# - Put private secrets only in Cloudflare Worker / server environment variables.

# ── Contact delivery → info@mernify.co ───────────────────────────────────────
# Architecture:
#   Form → POST /api/contact (Pages Function / Vite)
#        → EMAIL_SERVICE_URL (mail microservice, default https://mernify.co/api/email)
#        → info@mernify.co
#
# Auth header (server-side only): x-email-secret: EMAIL_SECRET
# Never put EMAIL_SECRET in VITE_*.
#
# Cloudflare Pages → Settings → Environment variables (Production + Preview):
#   EMAIL_SERVICE_URL = https://mernify.co/api/email
#   EMAIL_SECRET      = <same secret as the mail microservice>   [Encrypt]
#   CONTACT_TO        = info@mernify.co
#
# Local `.env`:
EMAIL_SERVICE_URL=https://mernify.co/api/email
# EMAIL_SECRET=
CONTACT_TO=info@mernify.co
CONTACT_FROM=Mernify <hello@mernify.co>
#
# Without EMAIL_SECRET the API returns HTTP 503 (no fake success).
# ── Booking ──────────────────────────────────────────────────────────────────
VITE_CALENDLY_URL=https://calendly.com/contact-mernify/30min

# ── Analytics (loads only after cookie consent) ──────────────────────────────
VITE_GA_MEASUREMENT_ID=G-DPSLHXJ6Q3

# ── Case study live-site preview proxy ───────────────────────────────────────
# Same-origin path used by default: /site-preview
# - Local: Vite middleware (dev + preview)
# - Cloudflare Pages: functions/site-preview.js (auto, no env needed)
#
# Only set this if you host elsewhere and deploy cf-worker/site-preview.js:
# VITE_PROXY_URL=https://mernify-preview.YOUR_SUBDOMAIN.workers.dev

# ── Mernify AI Sales Concierge (DeepSeek by default) ─────────────────────────
# Local Worker: npm run chat:worker  →  http://127.0.0.1:8787
# Put AI_API_KEY in cf-worker/.dev.vars (see cf-worker/.dev.vars.example)
# Docs: docs/mernify-ai/10-deepseek-local-setup.md
VITE_AI_CHAT_ENDPOINT=http://127.0.0.1:8787

# Feature flag: "true" = always on, "false" = always off, unset = on in dev / auto in prod
VITE_MERNIFY_AI_ENABLED=true

# Auto-open the chat when a visitor lands (once per browser session)
#   true    = every device (default)
#   desktop = skip screens ≤640px, where the panel is full-screen
#   false   = never; visitors open it from the launcher
VITE_CHAT_AUTO_OPEN=true
# Delay in ms, counted after the page entrance animation finishes
VITE_CHAT_AUTO_OPEN_DELAY=1500

# Production: set VITE_AI_CHAT_ENDPOINT to your deployed Worker URL instead.
# Worker secrets/vars (Cloudflare Dashboard / .dev.vars — NOT VITE_*):
#   AI_PROVIDER          = deepseek
#   AI_API_KEY           = sk-...             [Secret] — DeepSeek key
#   AI_PRIMARY_MODEL     = deepseek-chat
#   AI_FALLBACK_MODEL    = deepseek-chat
#   ADMIN_SECRET         = ...                [Secret] — knowledge review API
#   ALLOWED_ORIGIN       = http://localhost:5173,https://mernify.co,https://www.mernify.co
#   EMAIL_SERVICE_URL / EMAIL_SECRET          — lead delivery (same as contact form)
