# SPA-friendly nginx config for Mernify (mernify.co)
# Critical: try_files must fall back to index.html so React Router can handle routes.
# Without this, /case-studies may 403, /process may 404, and other routes show wrong content.

server {
  listen 443 ssl http2;
  server_name mernify.co www.mernify.co;

  root /var/www/mernify/dist;
  index index.html;

  # Security headers
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # Optional CSP — tighten script-src once GA/Calendly domains are confirmed.
  # IMPORTANT: include your contact Worker + Web3Forms in connect-src or the form will fail.
  # add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.workers.dev https://api.web3forms.com; frame-src https://www.google.com https://calendly.com;" always;

  # Hashed Vite assets — long cache
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Permanent redirect for legacy /work alias (SEO — avoid duplicate content)
  location = /work {
    return 301 /case-studies;
  }

  # SPA fallback — REQUIRED for client-side routing
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Do not serve directory indexes (prevents 403 on paths that exist as folders)
  autoindex off;
}

server {
  listen 80;
  server_name mernify.co www.mernify.co;
  return 301 https://$host$request_uri;
}
