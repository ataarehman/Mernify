{
  "name": "mernify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:ready": "vite build && node scripts/check-ready.mjs",
    "chat:worker": "wrangler dev --config cf-worker/wrangler.toml --port 8787",
    "chat:db:local": "wrangler d1 execute mernify-ai --local --config cf-worker/wrangler.toml --file=cf-worker/schema.sql"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/phudu": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "lucide-react": "^1.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.54.2",
    "vite": "^7.0.4",
    "wrangler": "^4.28.0"
  }
}
